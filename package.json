{
  "name": "paseo-release-agent",
  "version": "0.1.0",
  "description": "Paseo plugin to list agent sessions with memory use and release idle provider processes without archiving the agent",
  "author": "yusup (https://github.com/adeyusupp)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeyusupp/paseo-plugin-release-agent.git"
  },
  "homepage": "https://github.com/adeyusupp/paseo-plugin-release-agent#readme",
  "bugs": {
    "url": "https://github.com/adeyusupp/paseo-plugin-release-agent/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "memory",
    "claude",
    "codex",
    "idle"
  ],
  "os": [
    "linux"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "shared/",
    "server/",
    "!server/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test server/policy.test.ts server/procs.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
